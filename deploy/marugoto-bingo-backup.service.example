# Template only. Consistent SQLite copy (VACUUM INTO) + integrity check + pruning.
[Unit]
Description=Marugoto Bingo SQLite backup

[Service]
Type=oneshot
User=marugoto-bingo
Group=marugoto-bingo
WorkingDirectory=/opt/marugoto-bingo/current/server
EnvironmentFile=/etc/marugoto-bingo/marugoto-bingo.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning scripts/backup.js
ProtectSystem=strict
ReadWritePaths=/srv/backup/marugoto-bingo
ReadWritePaths=/var/lib/marugoto-bingo
