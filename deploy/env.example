# Example only. Copy to /etc/marugoto-bingo/marugoto-bingo.env (root:marugoto-bingo, mode 0640).
# Never commit the real file. Generate the secret with:  openssl rand -base64 48
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# The public HTTPS origin visitors open (undecided: DECISION-C25). Start-up fails while it is a placeholder.
PUBLIC_ORIGIN=https://CHANGE-ME.example.invalid
CARD_CLAIM_SECRET=
DB_PATH=/var/lib/marugoto-bingo/marugoto-bingo.sqlite
IMAGE_DIR=/var/lib/marugoto-bingo/images
WEB_DIR=/opt/marugoto-bingo/current/web
# Caddy runs on the same host; only loopback may set X-Forwarded-For.
TRUST_PROXY=127.0.0.1
IMAGE_RETENTION_DAYS=14
# Used by the backup timer. Put it on a different disk from DB_PATH.
BACKUP_DIR=/srv/backup/marugoto-bingo
BACKUP_KEEP=288
