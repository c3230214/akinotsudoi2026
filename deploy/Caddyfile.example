# Template only. Replace the host after DNS and the university's publication
# approval are confirmed (DECISION-C25). Caddy obtains the certificate
# automatically when port 80/443 are reachable; otherwise configure `tls`.
CHANGE-ME.example.invalid {
	# Compress pages, scripts and JSON, but not Server-Sent Events
	# (text/event-stream): compressing them can hold events back.
	encode {
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
			header Content-Type text/csv*
		}
	}
	reverse_proxy 127.0.0.1:3000 {
		# Server-Sent Events: send each event at once.
		flush_interval -1
	}
	request_body {
		max_size 1MB
	}
	log {
		output file /var/log/caddy/marugoto-bingo.log
	}
}
